{
  "name": "dojo-osp-website",
  "private": true,
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0 <12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "pnpm exec biome format --write src",
    "lint": "pnpm exec biome lint src",
    "lint:fix": "pnpm exec biome lint --fix src",
    "check": "pnpm exec biome check --write src"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "^0.42.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "starlight-blog": "^0.30.0",
    "starlight-image-zoom": "^0.16.0",
    "starlight-ion-theme": "^2.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
